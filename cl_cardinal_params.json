{
  "Waveform": {
    "type": "FDSN",
    "source": {
      "provider": "IRIS",
      "network": "PY",
      "array": "BPH*",
      "channel": "BHZ",
      "datapath": "Data/Virtual_Arrays/PFO/PFO.mseed",
      "sitepath": "Data/Virtual_Arrays/PFO/PFO.site",
      "korea_arrays": false,
      "remove_response": true,
      "remove_stations": null,
      "convert_units": null,
      "amp_units":"Velocity [m/s]"
    }
  },

  "Event": {
    "use": false,
    "time": null,
    "lat": null,
    "lon": null 
  },

  "Segmentor": {
    "f_min": 0.1,
    "f_max": 21,
    "win_min": 5, 
    "win_max": 100, 
    "type": "third_octave"
  }, 

  "ArrayProcessing": {
    "process": true,
    "adaptive_array": false,
    "signal_type": "seismic",
    "Plotting": {
      "semblance_threshold": 0.5,
      "clim_vtr": [0, 4],
      "clim_baz": null,
      "bandpass": [0.5, 5],
      "normalize": true,
      "spec_subplot": false,
      "scal_subplot": true
    }
  },  

  "Families" :{
    "dist_threshold": 3,
    "min_pixels": 25,
    "sigma_t": 2,
    "sigma_f": 2,
    "sigma_b": 10,
    "p_threshold": 0.1,
    "family_grouping": "adaptive_kdtree_window"

  },

  "Plot": true
}
